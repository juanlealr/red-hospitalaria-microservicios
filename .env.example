# Plantilla de variables de entorno del stack.
#
# Uso:
#   1. Copiar este archivo a .env          ->  cp .env.example .env
#   2. Generar un secreto propio y pegarlo en JWT_SECRET
#   3. docker compose up -d --build
#
# El archivo .env NO se versiona (está en .gitignore): cada equipo usa el suyo.
# Las credenciales de las bases de datos son de desarrollo local y coinciden con
# las que declara docker-compose.yml; cámbielas junto con ese archivo si las
# endurece.

# ------------------------------------------------------------------ JWT
# Secreto HS256 compartido por auth-service, gateway y los cuatro servicios de
# negocio. Debe ser EXACTAMENTE el mismo en todos: con él se firman y validan
# los tokens. Mínimo 32 bytes; 48 en base64 es un buen tamaño.
#
# Genérelo con:
#   Linux/macOS : openssl rand -base64 48
#   PowerShell  : [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#
# NUNCA reutilice el valor de ejemplo en un entorno real.
JWT_SECRET=cambie-este-valor-por-un-secreto-largo-y-aleatorio-de-al-menos-32-bytes

# ------------------------------------------------------- administrador inicial
# Usuario que auth-service siembra al arrancar si la tabla está vacía.
ADMIN_INICIAL_EMAIL=admin@hospital.com
ADMIN_INICIAL_PASSWORD=123456789
